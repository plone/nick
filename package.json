{
  "name": "@plone/nick",
  "description": "Nearly Headless CMS",
  "type": "module",
  "maintainers": [
    {
      "name": "Plone Foundation",
      "email": "plone-developers@lists.sourceforge.net",
      "url": "http://plone.org"
    }
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./*": {
      "import": "./*",
      "require": "./*"
    }
  },
  "nick": {
    "migrations": "src/migrations"
  },
  "files": [
    "src",
    "scripts",
    "locales",
    "knexfile.ts",
    "config.ts.sample",
    "tsconfig.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE.md"
  ],
  "bin": {
    "nick": "./scripts/nick.ts"
  },
  "license": "MIT",
  "version": "3.0.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:plone/nick.git"
  },
  "bugs": {
    "url": "https://github.com/plone/nick/issues",
    "email": "plone-developers@lists.sourceforge.net"
  },
  "homepage": "https://nick.docs.plone.org",
  "keywords": [
    "cms"
  ],
  "scripts": {
    "bootstrap": "pnpm install && pnpm create-config && pnpm migrate && pnpm seed",
    "coverage": "AUTH_RATE_LIMIT=1000 vitest --coverage",
    "convert": "tsx scripts/convert.ts",
    "export": "tsx scripts/export.ts",
    "create-config": "cp -n config.ts.sample config.ts",
    "i18n": "tsx scripts/i18n.ts",
    "i18n:ci": "pnpm i18n && git diff -G'^[^\"POT]' --exit-code",
    "knex": "tsx ./node_modules/knex/bin/cli.js",
    "lint": "./node_modules/eslint/bin/eslint.js --max-warnings=0 'src/**/*.{js,ts,json}' 'scripts/**/*.{js,ts,json}' 'packages/nick-example-addon/src/**/*.{js,ts,json}'",
    "migrate": "pnpm knex migrate:latest",
    "migrate:check": "tsx scripts/migrate-check.ts",
    "nick": "tsx scripts/nick.ts",
    "migrate:list": "pnpm knex migrate:list",
    "permissions:dry-run": "tsx scripts/permissions.ts",
    "prettier": "./node_modules/.bin/prettier --single-quote --check 'src/**/*.{js,ts,json}' 'scripts/**/*.{js,ts,json}' 'packages/nick-example-addon/src/**/*.{js,ts,json}'",
    "seed": "tsx scripts/seed.ts run",
    "seed:status": "tsx scripts/seed.ts status",
    "seed:upgrade": "tsx scripts/seed.ts upgrade",
    "start": "pnpm migrate:list && pnpm seed:status && NODE_ENV=development nodemon --exec 'tsx src/server.ts'",
    "rollback": "pnpm knex migrate:rollback --all",
    "reset": "pnpm rollback && pnpm migrate && pnpm seed",
    "test": "AUTH_RATE_LIMIT=1000 vitest",
    "typecheck": "tsc --noEmit",
    "workflows:import": "tsx scripts/workflows.ts"
  },
  "engines": {
    "node": "^22 || ^24 || ^25 || ^26"
  },
  "prettier": {
    "trailingComma": "all",
    "singleQuote": true
  },
  "devDependencies": {
    "@babel/core": "8.0.9",
    "@babel/plugin-transform-typescript": "8.0.6",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@plone/nick-example-addon": "workspace:*",
    "@types/du": "1.0.3",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/mime-types": "3.0.1",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pdf-parse": "1.1.5",
    "@types/supertest": "7.2.1",
    "@types/turndown": "5.0.6",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "glob": "13.0.6",
    "jiti": "2.7.0",
    "nodemon": "3.1.14",
    "pofile": "1.1.4",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "@formatjs/cli": "6.16.35",
    "@formatjs/intl": "6.1.4",
    "bcrypt": "6.0.0",
    "bcrypt-promise": "2.0.0",
    "dayjs": "1.11.23",
    "du": "1.0.0",
    "es-toolkit": "1.53.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "knex": "3.3.0",
    "log4js": "6.9.1",
    "mime-types": "3.0.2",
    "multer": "2.5.0",
    "node-cron": "4.6.0",
    "nodemailer": "10.2.1",
    "objection": "4.4.1",
    "pdf-parse": "2.4.5",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "slugify": "1.6.9",
    "tsx": "4.23.15",
    "turndown": "7.2.4",
    "uuid": "14.0.3",
    "xss": "1.0.17"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
