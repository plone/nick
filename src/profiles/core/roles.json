    {
      "id": "Administrator",
      "title:i18n": "Administrator",
      "permissions": [
        "Add",
        "Review",
        "Submit",
        "Manage Users",
        "Manage Site",
        "Modify Comments",
        "Delegate Reader",
        "Delegate Contributor",
        "Delegate Editor",
        "Delegate Reviewer",
        "Revert",
        "Delete",
        "View History",
        "Review Comments"
      ]
    }
