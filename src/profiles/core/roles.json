        "Manage Preferences",
        "View Comments",
        "Add Comment",
        "Modify Own Comments"
      ]
    },
    {
      "id": "Owner",
      "title:i18n": "Owner",
      "permissions": [
        "Add",
        "Submit",
        "Modify Comments",
        "Delegate Reader",
        "Delegate Contributor",
        "Delegate Editor",
        "Revert",
        "Delete",
        "View History"
      ]
    },
    {
      "id": "Reader",
      "title:i18n": "Reader",
      "permissions": ["View"]
    },
    {
